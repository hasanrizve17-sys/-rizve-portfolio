
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b14">
<title>Rizve | Piece Game Staff</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#080b14;--panel:#101727;--blue:#83aaff;--text:#f4f6ff;--muted:#a0abc1}
html{scroll-behavior:smooth}
body{background:radial-gradient(ellipse at top right,#172447 0%,var(--bg) 48%);color:var(--text);font-family:Arial,Helvetica,sans-serif;line-height:1.7}
a{color:inherit;text-decoration:none}
.container{width:min(1050px,90%);margin:auto}
nav{height:75px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #252d40}
.logo{font-weight:900;letter-spacing:3px;font-size:20px}
.logo span,.accent{color:var(--blue)}
.navlinks{display:flex;gap:25px;color:var(--muted);font-size:14px}
.navlinks a:hover{color:white}
.hero{padding:100px 0 85px;display:grid;grid-template-columns:1.4fr .6fr;align-items:center;gap:40px}
.badge{color:var(--blue);font-size:12px;letter-spacing:2px;font-weight:bold}
h1{font-size:clamp(48px,8vw,82px);line-height:1.08;letter-spacing:-3px;margin:16px 0}
h1 span{color:var(--blue)}
.hero p,.section-intro{color:var(--muted);max-width:600px}
.buttons{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}
.btn{display:inline-block;padding:11px 18px;border:1px solid #303b54;border-radius:10px;font-weight:bold;font-size:14px;transition:.2s}
.btn.primary{background:var(--blue);color:#071020;border-color:var(--blue)}
.btn:hover{transform:translateY(-3px)}
.emblem{height:260px;border:1px solid #303e60;border-radius:28px;background:linear-gradient(145deg,#192747,#0e1423);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.emblem:before,.emblem:after{content:"";position:absolute;width:220px;height:220px;border:1px solid #526caa66;border-radius:50%}
.emblem:after{width:170px;height:170px}
.initials{z-index:1;background:linear-gradient(135deg,#b8d0ff,#6288ee);color:#081020;border-radius:25px;padding:18px 23px;font-size:48px;font-weight:900;transform:rotate(-7deg);box-shadow:0 0 55px #6489ee55}
section{padding:55px 0}
.section-label{color:var(--blue);font-size:12px;letter-spacing:2px;font-weight:bold}
h2{font-size:clamp(28px,5vw,42px);letter-spacing:-1px;margin:5px 0 12px}
.section-intro{margin-bottom:25px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}
.card{background:linear-gradient(145deg,#131b2c,#0c111d);border:1px solid #28334a;border-radius:17px;padding:24px;transition:.2s}
.card:hover{border-color:#7298ef;transform:translateY(-4px)}
.card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:17px}
.icon{width:43px;height:43px;display:grid;place-items:center;background:#1c2a47;color:var(--blue);border:1px solid #33486f;border-radius:12px;font-weight:900}
.tag{font-size:11px;color:#bdcfff;border:1px solid #344463;padding:4px 9px;border-radius:30px}
h3{font-size:20px;margin-bottom:7px}
.card p,.about-card p{color:var(--muted);font-size:14px}
.status{display:inline-block;margin-top:16px;color:var(--blue);font-size:13px;font-weight:bold}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}
.about-card{background:var(--panel);border:1px solid #28334a;border-radius:17px;padding:25px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:17px}
.chip{font-size:12px;background:#1a2438;border:1px solid #303e58;border-radius:8px;padding:6px 10px;color:#dce5ff}
.contact{background:linear-gradient(120deg,#141f39,#0e1422);border:1px solid #34476d;border-radius:22px;padding:32px;display:flex;align-items:center;justify-content:space-between;gap:25px}
.contact p{color:var(--muted);font-size:14px;max-width:570px}
footer{margin-top:35px;padding:25px 0 35px;border-top:1px solid #252d40;color:var(--muted);font-size:12px;display:flex;justify-content:space-between;gap:12px}
@media(max-width:700px){
 .hero{grid-template-columns:1fr;padding:65px 0 40px;gap:28px}
 .emblem{height:200px}
 .grid,.about-grid{grid-template-columns:1fr}
 .navlinks{gap:13px;font-size:12px}
 .contact{align-items:flex-start;flex-direction:column;padding:24px}
 h1{letter-spacing:-2px}
}
@media(max-width:380px){.navlinks{gap:8px;font-size:11px}.logo{font-size:17px}}
</style>
</head>
<body>
<header class="container">
<nav>
<a class="logo" href="#home">RIZVE<span>.</span></a>
<div class="navlinks">
<a href="#experience">Experience</a>
<a href="#about">About</a>
<a href="#contact">Contact</a>
</div>
</nav>
</header>

<main>
